<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="state_law_definitions" name="Whether the agreement holds in a state" namespace="https://example.org/noncompete">
  <decision id="state_law" name="state_law">
    <decisionTable id="state_law_table" hitPolicy="FIRST">
      <input id="state_law_in1" label="state"><inputExpression typeRef="string"><text>state</text></inputExpression></input>
      <input id="state_law_in2" label="below_threshold"><inputExpression typeRef="boolean"><text>below_threshold</text></inputExpression></input>
      <input id="state_law_in3" label="all_exempt"><inputExpression typeRef="boolean"><text>all_exempt</text></inputExpression></input>
      <input id="state_law_in4" label="notice_days"><inputExpression typeRef="number"><text>notice_days</text></inputExpression></input>
      <input id="state_law_in5" label="garden_leave"><inputExpression typeRef="boolean"><text>garden_leave</text></inputExpression></input>
      <input id="state_law_in6" label="length_months"><inputExpression typeRef="number"><text>length_months</text></inputExpression></input>
      <input id="state_law_in7" label="signed_after_ban"><inputExpression typeRef="boolean"><text>signed_after_ban</text></inputExpression></input>
      <input id="state_law_in8" label="separate_notice"><inputExpression typeRef="boolean"><text>separate_notice</text></inputExpression></input>
      <output id="state_law_out1" name="allowed" typeRef="boolean"/>
      <output id="state_law_out2" name="holds" typeRef="string"/>
      <output id="state_law_out3" name="reason" typeRef="string"/>
      <output id="state_law_out4" name="citation" typeRef="string"/>
      <rule id="ca_void"><inputEntry><text>"CA"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"void"</text></outputEntry><outputEntry><text>"Void in California: stop using it, and notify current and former employees in writing that it is void"</text></outputEntry><outputEntry><text>"ca-bpc-16600; ca-bpc-16600.1; ca-bpc-16600.5"</text></outputEntry></rule>
      <rule id="mn_void"><inputEntry><text>"MN"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"void"</text></outputEntry><outputEntry><text>"Void in Minnesota for an agreement signed on or after 1 July 2023"</text></outputEntry><outputEntry><text>"mn-stat-181.988"</text></outputEntry></rule>
      <rule id="mn_earlier"><inputEntry><text>"MN"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>false</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"check separately"</text></outputEntry><outputEntry><text>"Signed before 1 July 2023: Minnesota's ban does not apply, and earlier law governs"</text></outputEntry><outputEntry><text>"mn-stat-181.988"</text></outputEntry></rule>
      <rule id="ok_void"><inputEntry><text>"OK"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"void"</text></outputEntry><outputEntry><text>"Void in Oklahoma: replace it with a clause against soliciting the employer's established customers"</text></outputEntry><outputEntry><text>"ok-15-217; ok-15-219a"</text></outputEntry></rule>
      <rule id="nd_void"><inputEntry><text>"ND"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"void"</text></outputEntry><outputEntry><text>"Void in North Dakota, except on selling a business or leaving a partnership or company"</text></outputEntry><outputEntry><text>"nd-cc-9-08-06"</text></outputEntry></rule>
      <rule id="co_below"><inputEntry><text>"CO"</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"only above threshold"</text></outputEntry><outputEntry><text>"Void for workers earning below Colorado's threshold for highly compensated workers: limit it to those above it, to protect trade secrets"</text></outputEntry><outputEntry><text>"co-crs-8-2-113"</text></outputEntry></rule>
      <rule id="co_notice"><inputEntry><text>"CO"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>false</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"with changes"</text></outputEntry><outputEntry><text>"Give notice of the covenant and its terms in a separate document, signed by the worker, before the offer is accepted"</text></outputEntry><outputEntry><text>"co-crs-8-2-113"</text></outputEntry></rule>
      <rule id="co_holds"><inputEntry><text>"CO"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"holds"</text></outputEntry><outputEntry><text>"Holds for highly compensated workers, to protect trade secrets, with separate notice"</text></outputEntry><outputEntry><text>"co-crs-8-2-113"</text></outputEntry></rule>
      <rule id="wa_below"><inputEntry><text>"WA"</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"only above threshold"</text></outputEntry><outputEntry><text>"Void for employees earning at or below Washington's threshold; from 30 June 2027 Washington voids nearly every non-compete"</text></outputEntry><outputEntry><text>"wa-rcw-49.62.020; wa-rcw-49.62.020-2027"</text></outputEntry></rule>
      <rule id="wa_holds"><inputEntry><text>"WA"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"holds until 30 June 2027"</text></outputEntry><outputEntry><text>"Disclose its terms in writing by the offer; pay the employee during the restriction if laid off; from 30 June 2027 Washington voids nearly every non-compete"</text></outputEntry><outputEntry><text>"wa-rcw-49.62.020; wa-rcw-49.62.020-2027"</text></outputEntry></rule>
      <rule id="il_below"><inputEntry><text>"IL"</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"only above threshold"</text></outputEntry><outputEntry><text>"Void for employees earning $75,000 a year or less ($80,000 from 1 January 2027)"</text></outputEntry><outputEntry><text>"il-820-90-10"</text></outputEntry></rule>
      <rule id="il_notice"><inputEntry><text>"IL"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>&lt; 14</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"with changes"</text></outputEntry><outputEntry><text>"Advise the employee in writing to consult a lawyer, and give at least 14 calendar days to review it"</text></outputEntry><outputEntry><text>"il-820-90-20"</text></outputEntry></rule>
      <rule id="il_holds"><inputEntry><text>"IL"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"holds if reasonable"</text></outputEntry><outputEntry><text>"Must also be reasonable and supported by adequate consideration"</text></outputEntry><outputEntry><text>"il-820-90-15"</text></outputEntry></rule>
      <rule id="ma_exempt"><inputEntry><text>"MA"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>false</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"with changes"</text></outputEntry><outputEntry><text>"Not enforceable against employees not exempt from overtime: limit it to exempt staff"</text></outputEntry><outputEntry><text>"ma-gl-149-24l"</text></outputEntry></rule>
      <rule id="ma_length"><inputEntry><text>"MA"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>&gt; 12</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"with changes"</text></outputEntry><outputEntry><text>"The restricted period may not exceed 12 months"</text></outputEntry><outputEntry><text>"ma-gl-149-24l"</text></outputEntry></rule>
      <rule id="ma_leave"><inputEntry><text>"MA"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>false</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"with changes"</text></outputEntry><outputEntry><text>"Add a garden leave clause paying at least 50% of pay, or other agreed consideration"</text></outputEntry><outputEntry><text>"ma-gl-149-24l"</text></outputEntry></rule>
      <rule id="ma_notice"><inputEntry><text>"MA"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>&lt; 10</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"with changes"</text></outputEntry><outputEntry><text>"Give it by the formal offer or 10 business days before employment starts, stating the right to consult counsel"</text></outputEntry><outputEntry><text>"ma-gl-149-24l"</text></outputEntry></rule>
      <rule id="ma_holds"><inputEntry><text>"MA"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"holds"</text></outputEntry><outputEntry><text>"Meets the Massachusetts Noncompetition Agreement Act"</text></outputEntry><outputEntry><text>"ma-gl-149-24l"</text></outputEntry></rule>
      <rule id="fl_long"><inputEntry><text>"FL"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>&gt; 24</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"with changes"</text></outputEntry><outputEntry><text>"More than 2 years is presumed unreasonable against a former employee"</text></outputEntry><outputEntry><text>"fl-stat-542.335"</text></outputEntry></rule>
      <rule id="fl_holds"><inputEntry><text>"FL"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"likely"</text></outputEntry><outputEntry><text>"Up to 2 years is not presumed unreasonable; 6 months or less is presumed reasonable"</text></outputEntry><outputEntry><text>"fl-stat-542.335"</text></outputEntry></rule>
      <rule id="tx_reasonable"><inputEntry><text>"TX"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"likely, if reasonable"</text></outputEntry><outputEntry><text>"Must be ancillary to an otherwise enforceable agreement and reasonable in time, area and scope; a court reforms one that is broader than necessary (see similar cases)"</text></outputEntry><outputEntry><text>"tx-bcc-15.50; tx-bcc-15.51"</text></outputEntry></rule>
      <rule id="ny_cases"><inputEntry><text>"NY"</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>true</text></outputEntry><outputEntry><text>"case by case"</text></outputEntry><outputEntry><text>"No statute: courts enforce a covenant only as far as it protects a legitimate interest (see similar cases)"</text></outputEntry><outputEntry><text>""</text></outputEntry></rule>
      <rule id="not_held"><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>false</text></outputEntry><outputEntry><text>"not covered"</text></outputEntry><outputEntry><text>"This example holds no law for this state"</text></outputEntry><outputEntry><text>""</text></outputEntry></rule>
    </decisionTable>
  </decision>
</definitions>
